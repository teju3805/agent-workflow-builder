# ---- shared secret between Hasura and the functions ------------------------
INTERNAL_WEBHOOK_SECRET=change-me-to-something-long

# ---- LLM (Groq / OpenRouter / any OpenAI-compatible endpoint) --------------
# Leave LLM_API_KEY empty to use the disclosed stub (~900ms, output marked stubbed:true)
LLM_API_KEY=
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=llama-3.1-8b-instant

# ---- optional Slack delivery for notify steps ------------------------------
SLACK_WEBHOOK_URL=

# ---- how the functions reach Hasura ----------------------------------------
NHOST_GRAPHQL_URL=http://localhost:1337/v1/graphql
NHOST_ADMIN_SECRET=nhost-admin-secret

# ---- Event Trigger targets (same metadata works locally and in the cloud) --
NHOST_FUNCTIONS_URL_RUN_EXECUTOR=http://functions:3000/events/run-executor
NHOST_FUNCTIONS_URL_NOTIFY=http://functions:3000/events/notify
NHOST_FUNCTIONS_URL_WATCHED_ROW=http://functions:3000/events/watched-row
